# Used by vite.config.ts's dev proxy (server.proxy["/api"].target).
# Defaults to the CineBase backend if unset: http://63.186.121.100
VITE_API_URL=http://63.186.121.100

# In production the app calls `/api/...` directly with no proxy, so it
# needs a same-origin reverse proxy to this backend, or the backend
# needs to send Access-Control-Allow-Origin for your deployed domain.
